{
    "name": "fabpot/tolerant-php-parser",
    "description": "Tolerant PHP-to-AST parser for IDE usage scenarios",
    "type": "library",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Lourens",
            "email": "roblou@microsoft.com"
        },
        {
            "name": "Fabien Potencier",
            "homepage": "https://fabien.potencier.org"
        }
    ],
    "support": {
        "issues": "https://github.com/fabpot/tolerant-php-parser/issues",
        "source": "https://github.com/fabpot/tolerant-php-parser"
    },
    "autoload": {
        "psr-4": { "Microsoft\\PhpParser\\": ["src/"] }
    },
    "autoload-dev": {
        "psr-4": { "Microsoft\\PhpParser\\Tests\\Unit\\": ["tests/unit/"] }
    }
}
